{
  "name": "kanso-workspace",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-tests.mjs",
    "dev": "vite --config examples/lab/vite.config.ts",
    "build:example": "node scripts/build-example.mjs",
    "preview": "node examples/lab/serve.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "bench": "node scripts/benchmark.mjs",
    "check": "npm run check:format && npm run build && npm run typecheck && npm test && npm run build:example && npm run build:catalog && npm run check:dependencies",
    "test:tooling": "node scripts/tooling-tests.mjs",
    "test:seo": "node scripts/seo-tests.mjs",
    "test:dx": "node scripts/dx-tests.mjs",
    "test:hmr": "node scripts/hmr-tests.mjs",
    "build:catalog": "node scripts/build-example.mjs catalog",
    "dev:catalog": "vite --config examples/catalog/vite.config.ts",
    "preview:catalog": "cd examples/catalog && PORT=4175 node scripts/serve.mjs",
    "format:examples": "node scripts/format-examples.mjs --write",
    "check:format": "node scripts/format-examples.mjs",
    "test:web": "node scripts/web-tests.mjs",
    "test:workers": "node scripts/worker-tests.mjs",
    "test:service-workers": "node scripts/service-worker-tests.mjs",
    "test:microfrontends": "node scripts/microfrontends-tests.mjs",
    "test:microfrontends-dx": "node scripts/microfrontends-dx-tests.mjs",
    "test:microfrontends-dev": "node scripts/microfrontends-dev-tests.mjs",
    "build:microfrontends": "node examples/microfrontends/scripts/build.mjs",
    "dev:microfrontends": "node examples/microfrontends/scripts/dev.mjs",
    "preview:microfrontends": "node examples/microfrontends/scripts/serve.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/generator": "^7.28.0",
    "@babel/parser": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/traverse": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.0",
    "babel-preset-solid": "1.9.15",
    "esbuild": "0.28.2",
    "jsdom": "^26.1.0",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "typescript": "^5.9.0",
    "vite": "8.3.0",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.11",
    "@types/semver": "^7.7.0"
  }
}
