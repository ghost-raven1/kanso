FROM mcr.microsoft.com/playwright:v1.63.0-noble
WORKDIR /work
COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci --ignore-scripts
COPY . .
CMD ["sh", "-c", "npm run check && npm run test:browser && npm run test:hmr && npm run test:dx && npm run test:web && cp output/web/results.json /results/web.json && cp output/hmr/results.json /results/hmr.json && cp output/dx/results.json /results/dx.json && cp output/browser/results.json /results/browser.json"]
