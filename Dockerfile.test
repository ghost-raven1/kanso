FROM mcr.microsoft.com/playwright:v1.63.0-noble
WORKDIR /work
COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci --ignore-scripts
COPY . .
CMD ["sh", "-c", "npm run check && npm run test:browser && npm run test:compatibility && npm run test:tooling && npm run test:seo && npm run test:hmr && npm run test:dx && npm run test:web && npm run test:workers && npm run test:service-workers && npm run test:microfrontends-dx && npm run test:microfrontends-dev && npm run test:microfrontends && cp output/services/results.json /results/services.json && cp output/compatibility/results.json /results/compatibility.json && cp output/web/results.json /results/web.json && cp output/hmr/results.json /results/hmr.json && cp output/dx/results.json /results/dx.json && cp output/browser/results.json /results/browser.json && cp output/workers/results.json /results/workers.json && cp output/service-workers/results.json /results/service-workers.json && cp output/microfrontends-dx/results.json /results/microfrontends-dx.json && cp output/microfrontends-dev/results.json /results/microfrontends-dev.json && cp output/microfrontends/results.json /results/microfrontends.json"]
